{
  "name": "migratlas-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:svelte": "node tools/svelte-check/node_modules/svelte-check/bin/svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:build": "node scripts/check-build.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "roughjs": "^4.6.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.186.0",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
