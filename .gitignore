# ---------------------------------------------------------------------------
# Data. Never committed -- not for size reasons alone, but because the ethics
# gate governs what may leave this machine and git history is not revocable.
# ---------------------------------------------------------------------------
# Anchored. Unanchored `data/` matches any directory of that name at any depth, which
# quietly swallowed docs/data/PROVENANCE.md -- the generated credit ledger every source's
# licence requires us to publish.
/data/
*.parquet
*.zarr/
*.nc
*.grib
*.tif
*.tiff
*.pmtiles
*.mbtiles

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Node
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
web/test-results/
web/playwright-report/

# R
.Rhistory
.RData
.Rproj.user/
R/renv/library/
R/renv/staging/

# Secrets and machine-local config. Anything *.local.md documents one particular
# machine -- paths, hardware, OS quirks -- and is nobody else's business.
.env
.env.local
*.local.md
*.key
*.pem
credentials.json

# Notebook outputs are stripped, but guard against checkpoints anyway
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.claude/
